on_actions = {
  on_startup = {
    effect = {
      if = {
        limit = { NOT = { has_global_flag = wa_mp_fix_italy_state_buffs_applied } }
        set_global_flag = wa_mp_fix_italy_state_buffs_applied

        # =============================================================
        # ITALY STATE BUFFS (IRON + FACTORIES)
        # =============================================================
        #
        # ---- STEEL (resource) examples ----
        # Messina
        effect = {
	      every_state = {
	        limit = {
	          state = 115
	          is_controlled_by = ITA
	        }
	        add_dynamic_modifier = { modifier = wa_mp_fix_ita_boost_resources }
	      }
	    }
        #
        # ---- FACTORY examples (state-scope by numeric ID) ----
        # Messina
        115 = {
          add_extra_state_shared_building_slots = 20
          add_building_construction = {
            type = arms_factory
            level = 20
            instant_build = yes
          }
        }
        115 = {
          add_extra_state_shared_building_slots = 20
          add_building_construction = {
            type = industrial_complex
            level = 20
            instant_build = yes
          }
        }
		115 = {
          add_extra_state_shared_building_slots = 15
          add_building_construction = {
            type = dockyards
            level = 15
            instant_build = yes
          }
        }
      }
    }
  }
}
