on_actions = {
  on_startup = {
    effect = {
      if = {
        limit = { NOT = { has_global_flag = wa_mp_fix_italy_state_buffs_applied } }
        set_global_flag = wa_mp_fix_italy_state_buffs_applied

        # =============================================================
        # SPECIAL RESOURCES (attach dynamic modifier to 7 states)
        # =============================================================
        random_country = {
          448 = { add_dynamic_modifier = { modifier = ita_special_resources } }
          661 = { add_dynamic_modifier = { modifier = ita_special_resources } }
          449 = { add_dynamic_modifier = { modifier = ita_special_resources } }
          662 = { add_dynamic_modifier = { modifier = ita_special_resources } }
          450 = { add_dynamic_modifier = { modifier = ita_special_resources } }
          663 = { add_dynamic_modifier = { modifier = ita_special_resources } }
          451 = { add_dynamic_modifier = { modifier = ita_special_resources } }
        }

        # =============================================================
        # ITALY STATE BUFFS (RESOURCES)
        # =============================================================
        115 = {
          if = {
            limit = { is_controlled_by = ITA }
            add_dynamic_modifier = { modifier = wa_mp_fix_ita_boost_resources }
          }
        }

        # =============================================================
        # START ITALY "FOCUS -> BUILDINGS" WATCHER
        # (buildings will be added when the corresponding focuses are completed)
        # =============================================================
        ITA = { country_event = { id = wa_mp_ita_bld.10 days = 10 } }
      }
    }
  }
}
